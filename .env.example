# Copy to .env.local and fill in. `npm run check-env` validates .env.local
# against this file (dotenv-safe), and postinstall runs it.
#
# EVERY UNCOMMENTED KEY BELOW IS REQUIRED and must be non-empty — that is the
# whole contract, so only add a key here if the app is broken or insecure
# without it. Optional settings are listed as comments further down; commented
# lines are invisible to dotenv-safe, which is what makes them optional.

# --- Database -----------------------------------------------------------------
# Prisma reads this (prisma/schema.prisma). Nothing works without it.
DATABASE_URL="postgresql://username:password@localhost:5432/stablekraft_music"

# --- Podcast Index API --------------------------------------------------------
# Every feed lookup and resolution goes through this API. Never fetch Wavlake
# directly. https://api.podcastindex.org/signup
PODCAST_INDEX_API_KEY=your_key_here
PODCAST_INDEX_API_SECRET=your_secret_here

# --- Auth: both of these FAIL OPEN when unset ---------------------------------
# They are required rather than optional for exactly that reason — an unset
# secret is not a disabled feature, it is a disabled guard that still serves
# traffic.

# Signs the httpOnly session cookie that tells a route who is calling
# (lib/auth/require-user.ts). Unset = requireUser falls back to the unverified
# x-nostr-user-id header, i.e. anyone can act as any user.
# Generate: openssl rand -base64 48
SESSION_SECRET=

# Bearer secret gating /api/admin/* and the destructive maintenance endpoints
# (middleware.ts). Unset = those endpoints are open. Set the SAME value in
# Railway and as a GitHub Actions secret — the nightly workflows send it as
# `Authorization: Bearer`.
# Generate: openssl rand -base64 48
ADMIN_SECRET=


# ==============================================================================
# OPTIONAL — every setting below has a working default or a feature-off default.
# Uncomment in .env.local only. Do NOT uncomment here: any uncommented key
# becomes mandatory for every developer.
# ==============================================================================

# --- Base URL -----------------------------------------------------------------
# Defaults to https://stablekraft.app. NEXT_PUBLIC_* bakes in at BUILD time, so
# set it before the build that should use it, not after.
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Nostr --------------------------------------------------------------------
# Comma-separated relay list; falls back to a built-in default set.
# NEXT_PUBLIC_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.snort.social

# Comma-separated npubs allowed into the admin panel UI (separate from
# ADMIN_SECRET, which gates the API).
# ADMIN_NPUBS=npub1abc...,npub1def...

# --- Cross-app shared favorites (kind 10333) ----------------------------------
# Empty/unset = entirely off: no relay read, no publish, no reconcile. See the
# favorites-cross-app skill before changing any of these.
# NEXT_PUBLIC_SHARED_FAVORITES_PUBKEYS=npub1...
# SHARED_FAVORITES_APPLY_DELETES=false    # the only destructive write; snapshot first
# SHARED_FAVORITES_IMPORT_UNKNOWN=false   # mint Feed rows from another app's list

# --- Lightning ----------------------------------------------------------------
# Platform fee destination. Both have defaults in lib/lightning/config.ts.
# NEXT_PUBLIC_PLATFORM_LIGHTNING_ADDRESS=you@getalby.com
# NEXT_PUBLIC_PLATFORM_NODE_PUBKEY=your_node_pubkey_here

# BoostBox stores Podcasting 2.0 boost metadata for LNURL payments, which
# cannot carry TLV records. BOOSTBOX_URL defaults to https://tardbox.com.
# BOOSTBOX_URL=https://tardbox.com
# BOOSTBOX_API_KEY=your_boostbox_key

# --- Misc ---------------------------------------------------------------------
# ENABLE_SERVER_SIDE_FETCH=false
# NEXT_PUBLIC_LOG_LEVEL=warn

# --- Set by the platform, not by you ------------------------------------------
# NODE_ENV, PORT, VERCEL, RAILWAY_GIT_COMMIT_SHA, NEXT_PUBLIC_APP_VERSION and
# NEXT_PUBLIC_BUILD_VERSION are provided by Next.js, Railway or the build. Do
# not put them in .env.local.
#
# CHROME_PATH and PROBE_ORIGIN are read only by
# lib/nostr/nwc-backup.browser-probe.mjs and are passed on its command line.

# ---------------------------------------------------------------------------
# Forked-shell gate (see lib/native-app-identity.ts)
# ---------------------------------------------------------------------------
# The Android APK is a WebView pointed at server.url in capacitor.config.ts, so
# a fork that leaves that line alone serves every byte off THIS deployment. The
# gate blocks a native Android shell whose applicationId is not ours. It touches
# no browser and no StableKraft APK of any vintage; anything it cannot identify
# is allowed.
#
# Both of these are NEXT_PUBLIC_* and therefore bake in at BUILD time — set them
# in Railway BEFORE the deploy that should use them.

# block (default) | log (report only, render anyway) | off (disable entirely)
NEXT_PUBLIC_FOREIGN_SHELL_GATE=block

# Extra package ids allowed to load the site natively, comma-separated.
# app.stablekraft is always allowed and cannot be removed here.
# NEXT_PUBLIC_ALLOWED_APP_IDS=

# ---------------------------------------------------------------------------
# Per-IP rate limits on the costly routes (see lib/rate-limit-guard.ts)
# ---------------------------------------------------------------------------
# log (default) records an overage with console.warn and serves the request
# anyway; enforce returns 429. A plain server variable, so switching to enforce
# takes effect on restart with no rebuild. Read the warnings before flipping.
RATE_LIMIT_MODE=log

# ---------------------------------------------------------------------------
# Media proxy host binding (see lib/proxy-host-allowlist.ts)
# ---------------------------------------------------------------------------
# /api/proxy-image and /api/proxy-audio accept a caller-supplied ?url=. The SSRF
# guard permits every PUBLIC host, so they were an open proxy for the whole
# internet. They now allow a target host only if the catalog references it.
# log (default) warns and serves anyway; enforce refuses. A plain server
# variable, so switching takes effect on restart with no rebuild.
PROXY_HOST_MODE=log
